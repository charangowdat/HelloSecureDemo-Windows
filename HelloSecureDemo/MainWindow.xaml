<Window x:Class="HelloSecureDemo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HelloSecure Demo" Height="430" Width="560" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#101827">
<Grid Margin="32"><StackPanel VerticalAlignment="Center">
<TextBlock Text="HELLOSECURE" Foreground="#7DD3FC" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
<TextBlock x:Name="Heading" Text="Welcome back" Foreground="White" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
<TextBlock x:Name="Hint" Text="Create a password to secure this demo." Foreground="#B8C5D6" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
<PasswordBox x:Name="PasswordInput" Height="44" FontSize="16" Padding="10" MaxLength="128" Margin="12,0"/>
<Button x:Name="PasswordButton" Content="Create password" Height="44" Margin="12,12" Click="PasswordButton_Click" Background="#0284C7" Foreground="White" FontSize="15" FontWeight="SemiBold" BorderThickness="0"/>
<Button x:Name="HelloButton" Content="Use Windows Hello (fingerprint / PIN)" Height="42" Margin="12,0" Click="HelloButton_Click" Background="#26364C" Foreground="White" FontSize="14" BorderThickness="0" IsEnabled="False"/>
<TextBlock x:Name="Status" Foreground="#FCA5A5" TextAlignment="Center" TextWrapping="Wrap" Margin="12,16,12,0"/>
</StackPanel></Grid></Window>
